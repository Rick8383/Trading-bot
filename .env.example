# Copy to .env and fill in. NEVER commit the real .env.
MODE=paper

# Database (optional in Phase 1; used once PostgreSQL persistence is enabled)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trading
DB_USER=trader
DB_PASSWORD=trader

REDIS_URL=redis://redis:6379

# Broker / data API keys (leave empty until live trading is manually unlocked)
ALPACA_KEY=
ALPACA_SECRET=
BINANCE_KEY=
BINANCE_SECRET=

# Alerting
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=

# Safety: live trading stays disabled unless explicitly set to "I_UNDERSTAND_THE_RISK"
LIVE_TRADING_UNLOCK=
