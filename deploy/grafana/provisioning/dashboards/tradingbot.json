{
  "title": "Trading Bot — Overview",
  "uid": "tradingbot-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Equity",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "tradingbot_equity", "refId": "A" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Drawdown",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "tradingbot_drawdown", "refId": "A" }]
    },
    {
      "id": 3, "type": "stat", "title": "Kill switch",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "tradingbot_kill_switch_active", "refId": "A" }]
    },
    {
      "id": 4, "type": "stat", "title": "Sharpe",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "expr": "tradingbot_sharpe", "refId": "A" }]
    },
    {
      "id": 5, "type": "stat", "title": "Profit factor",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [{ "expr": "tradingbot_profit_factor", "refId": "A" }]
    },
    {
      "id": 6, "type": "stat", "title": "Closed trades",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [{ "expr": "tradingbot_trades_total", "refId": "A" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Lessons learned (total)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "tradingbot_lessons_total", "refId": "A" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "Win rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "tradingbot_win_rate", "refId": "A" }]
    }
  ]
}
